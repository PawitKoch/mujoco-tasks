<mujoco model="dual_arm_handover">
  <compiler meshdir="../assets" texturedir="../assets"/>

  <statistic center="0 -0.1 0.2" extent="0.6" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision">
      <geom type="mesh" solimp="0.95 0.95 0.01" solref="0.01 1" group="3"/>
    </default>
  </default>

  <asset>
    <!-- Arm -->
    <model name="xarm7" file="xarm7.xml"/>

    <!-- Table dimensions (length x width x height in meters): 1.5x1.5x1 -->
    <mesh file="table/tablelegs.obj" scale="1.5 1.5 1"/>
    <mesh file="table/tabletop.obj" scale="1.5 1.5 1"/>
    <texture type="2d" file="table/small_meta_table_diffuse.png"/>
    <material name="table" texture="small_meta_table_diffuse"/>

    <!-- YCB objects -->
    <mesh name="ycb_foam_brick" file="ycb_foam_brick/textured.obj"/>
    <mesh name="ycb_bowl" file="ycb_bowl/textured.obj"/>
    <texture name="ycb_foam_brick" type="2d" file="ycb_foam_brick/textured_map.png"/>
    <texture name="ycb_bowl" type="2d" file="ycb_bowl/texture_map.png"/>
    <material name="ycb_foam_brick" texture="ycb_foam_brick"/>
    <material name="ycb_bowl" texture="ycb_bowl"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0.1 2.5"/>
    <geom name="floor" size="2 2 0.05" type="plane" material="groundplane" pos="0 0 -.75"/>

    <!-- Left Arm -->
    <body name="left_arm" pos="-0.75 0 0">
      <geom name="left_arm_base" type="cylinder" size=".06 .06" pos="0 0 .06" rgba="1 1 1 1"/>
      <attach model="xarm7" prefix="left_"/>
    </body>

    <!-- Right Arm -->
    <body name="right_arm" pos="0.75 0 0" quat="0 0 0 1">
      <geom name="right_arm_base" type="cylinder" size=".06 .06" pos="0 0 .06" rgba="1 1 1 1"/>
      <attach model="xarm7" prefix="right_"/>
    </body>

    <!-- Foam brick -->
    <body name="foam_brick" pos="0.35 0 0.05">
      <geom pos="0.02 -0.015 -0.023" mesh="ycb_foam_brick" material="ycb_foam_brick" class="visual"/>
      <geom name="foam_brick_collision" size="0.025 0.035 0.025" mass="0.1" type="box" class="collision"/> 
      <freejoint/>
    </body>

    <!-- Bowl -->
    <body name="bowl" pos="0 0.35 0.05">
      <geom mesh="ycb_bowl" material="ycb_bowl" class="visual"/>
      <geom name="bowl_collision" mesh="ycb_bowl" mass="0.25" margin="0.002" class="collision"/> 
      <freejoint/>
    </body>

    <!-- Table -->
    <geom mesh="tabletop" material="table" class="visual" pos="0 0 -0.75" quat="1 0 0 1"/>
    <geom mesh="tablelegs" material="table" class="visual" pos="0 0 -0.75" quat="1 0 0 1"/>
    <geom name="table" pos="0 0 -0.1009" size="0.915 0.555 0.1" type="box" class="collision"/>
  </worldbody>
</mujoco>